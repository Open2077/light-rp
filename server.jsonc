{
  "$schema": "./config/server.schema.json",
  "schemaVersion": 1,
  "rcon": {
    "enabled": true,
    "bindAddress": "127.0.0.1",
    "port": 11831,
    "passwordEnvironmentVariable": "OP77_RCON_PASSWORD",
    "permissions": ["*"]
  },
  "identity": {
    "name": "Open//77 Official Roleplay",
    "description": "Serveur Light RP officiel d\u0027Open//77 : un personnage, un chat de proximit\u00E9, des v\u00E9hicules civils, un staff. Tapez /help en jeu.",
    "locale": "fr-FR",
    "tags": [
      "roleplay",
      "light-rp",
      "fr"
    ],
    "website": "https://open2077.net/",
    "icon": "server-icon.png",
    "banner": "server-banner.png",
    "visibility": "unlisted"
  },
  "network": {
    "port": 11828,
    "publicEndpoint": "127.0.0.1:11828",
    "maximumPlayers": 64
  },
  "simulation": {
    "tickRate": 30,
    "snapshotRate": 20,
    "expectedGameBuild": 25000,
    "helloTimeoutSeconds": 10,
    "connectGateTimeoutSeconds": 8,
    "playerInterestRadius": 0,
    "playerInterestHysteresis": 60
  },
  "voice": {
    "enabled": true,
    "quality": "standard",
    "proximityDistance": 15,
    "minimumClientProximityDistance": 1,
    "maximumClientProximityDistance": 40,
    "maximumChannelAudience": 64,
    "maximumSimultaneousTalkers": 24,
    "maximumTalkersPerRecipient": 8,
    "globalEgressKbps": 0,
    "recipientEgressKbps": 0,
    "ingressRejectLimit": 200,
    "ingressRejectWindowSeconds": 10,
    "ingressBackoffMilliseconds": 250
  },
  "masterServer": {
    "enabled": true,
    "url": "https://master.open2077.net/",
    "tokenEnvironmentVariable": "OP77_MASTER_TOKEN",
    "identityFile": ".open77/master-identity.json",
    "heartbeatIntervalSeconds": 30,
    "licenseKeyEnvironmentVariable": "OP77_LICENSE_KEY",
    "requireConnectTicket": true,
    "publishPlayerList": true,
    "devLocalAuth": false
  },
  "resources": {
    "enabled": true,
    "root": "resources",
    "load": [
      "archivexl",
      "open77_board_games",
      "open77_tabletop_extra",
      "open77_casino_slots",
      "open77_casino_blackjack",
      "open77_casino_fortune",
      "open77_maneki",
      "open77_casino_pool",
      "lobby",
      "open77_lobby_cubes",
      "kabuki_appart1",
      "appart3",
      "entrepot1",
      "ncpd_watson",
      "cardealer",
      "ncwe_local",
      "casino",
      "place_casino",
      "polyzone",
      "open77_contextmenu",
      "open77_admin",
      "open77_shell",
      "open77_pause",
      "open77_chat",
      "open77_voice",
      "open-voice",
      "open77_weather",
      "open77_blips",
      "open77_notifications",
      "open77_death",
      "open77_appearance",
      "open77_cyberware",
      "open77_dash",
      "open77_reflex",
      "open77_effects",
      "open77_equipment",
      "open77_wardrobe",
      "open77_wardrobe_ui",
      "open77_perspective",
      "open77_animations",
      "open77_prevention",
      "open77_player_interactions",
      "open77_vehicles",
      "open77_elevators",
      "open77_doors",
      "open77_weapons",
      "open77_props",
      "open77_media",
      "open77_remote_camera",
      "open77_interactions",
      // Seats on chairs, couches and benches with ALT + click (open77_seating, menu mode);
      // the three below are its dependencies. None ships in the server distribution, and
      // all four are opt-in (auto_start false): see "startup" for the ensures.
      "open77_uikit",
      "open77_actions",
      "open77_furniture",
      "open77_seating",
      "open77_worldui",
      "open77_zones",
      "open77_icons",
      "open77_gizmos_demo",
      "open77_gizmos_editor",
        "open77_chimera",
        "op77_map3d",
        "op77_loadscreen",
        "op77_actionbubble",
      "op77_playermarks",
        "op77_speedometer",
        "op77_weaponhud",
        "op77_lightrp",
        "op77_scenes",
        "op77_ripperdoc",
        "op77_neuralink",
        // Light RP activities: each registers with op77_lightrp at start, so Adam Smasher's
        // terminal at The Crossing lists nothing without them. Their tables self-create.
        "op77_fireworks",
        "op77_race",
        "op77_chase",
        "op77_turf",
        "op77_arena"
    ],
    "autoStart": true,
    "watchIntervalMilliseconds": 0,
    "download": {
      "enabled": true,
      "listenUrl": "http://0.0.0.0:11829",
      "publicBaseUrl": "http://127.0.0.1:11829/",
      "allowInsecureHttp": true,
      "cacheDirectory": ".open77/resource-cache",
      "signingKeyFile": ".open77/resource-signing-key.json",
      "chunkSizeBytes": 1048576
    }
  },
  "requiredMods": {
    "enabled": true,
    "unsecured": true,
    "packages": []
  },
  "accessControl": {
    "file": "acl.jsonc"
  },
  "database": {
    "enabled": true,
    "connectionString": "",
    "connectionStringEnvironmentVariable": "OP77_DATABASE_CONNECTION",
    "maxRows": 10000
  },
  "http": {
    "enabled": false,
    "allowedHosts": [],
    "timeoutSeconds": 10,
    "maxResponseBytes": 1048576
  },
  "httpHandlers": {
    "enabled": false,
    "listenUrl": "http://127.0.0.1:11781",
    "timeoutSeconds": 5
  },
  "warden": {
    "enabled": true,
    "listenUrl": "http://127.0.0.1:11830",
    "hubFileGatewayOrigin": "https://files.open2077.net"
  },
  "startup": {
    // Opt-in (auto_start false) resources are not started by the load list alone.
    "commands": ["ensure open77_furniture", "ensure open77_actions", "ensure open77_seating"]
  },
  "convars": {
    // Seats are chosen with ALT + click on the furniture (open77_contextmenu), no E card;
    // no /sit or /stand player command (Light RP has no out-of-character commands).
    "open77_seating_ui": "menu",
    "open77_seating_commands": "0",
    // The crowd. At the default density (8) and caps (200 walkers + 256 seated per player) the spawn
    // square kept every client at its 480 live-entity cap: the players' own animation devices queued
    // past their 8 s timeout ("Animation unavailable: playback_timeout", 2026-11-04). Density as on
    // the owner's local server, at most 200 pedestrians around a player, and none within 40 m of
    // the spawn (open77_pedestrians exclusion zones: "x,y,z,radius;...").
    "open77_pedestrians_crowd_density": "2.5",
    "open77_pedestrians_crowd_max_near_player": "120",
    "open77_pedestrians_max_near_player": "80",
    "open77_pedestrians_crowd_max_cluster": "300",
    "open77_pedestrians_exclusions": "-779.648,781.561,22.580,40"
  }
}
