{
  "$schema": "./config/server.schema.json",
  "schemaVersion": 1,
  "rcon": {
    "enabled": true,
    "bindAddress": "127.0.0.1",
    "port": 11831,
    "passwordEnvironmentVariable": "OP77_RCON_PASSWORD",
    "permissions": ["*"]
  },
  "identity": {
    "name": "Open//77 Official Roleplay",
    "description": "Serveur Light RP officiel d\u0027Open//77 : un personnage, un chat de proximit\u00E9, des v\u00E9hicules civils, un staff. Tapez /help en jeu.",
    "locale": "fr-FR",
    "tags": [
      "roleplay",
      "light-rp",
      "fr"
    ],
    "website": "https://open2077.net/",
    "icon": "server-icon.png",
    "banner": "server-banner.png",
    "visibility": "unlisted"
  },
  "network": {
    "port": 11828,
    "publicEndpoint": "127.0.0.1:11828",
    "maximumPlayers": 64
  },
  "simulation": {
    "tickRate": 30,
    "snapshotRate": 20,
    "expectedGameBuild": 25000,
    "helloTimeoutSeconds": 10,
    "connectGateTimeoutSeconds": 8,
    "playerInterestRadius": 0,
    "playerInterestHysteresis": 60
  },
  "voice": {
    "enabled": true,
    "quality": "standard",
    "proximityDistance": 15,
    "minimumClientProximityDistance": 1,
    "maximumClientProximityDistance": 40,
    "maximumChannelAudience": 64,
    "maximumSimultaneousTalkers": 24,
    "maximumTalkersPerRecipient": 8,
    "globalEgressKbps": 0,
    "recipientEgressKbps": 0,
    "ingressRejectLimit": 200,
    "ingressRejectWindowSeconds": 10,
    "ingressBackoffMilliseconds": 250
  },
  "masterServer": {
    "enabled": true,
    "url": "https://master.open2077.net/",
    "tokenEnvironmentVariable": "OP77_MASTER_TOKEN",
    "identityFile": ".open77/master-identity.json",
    "heartbeatIntervalSeconds": 30,
    "licenseKeyEnvironmentVariable": "OP77_LICENSE_KEY",
    "requireConnectTicket": true,
    "publishPlayerList": true,
    "devLocalAuth": false
  },
  "resources": {
    "enabled": true,
    "root": "resources",
    "load": [
      "archivexl",
      "lobby",
      "open77_lobby_cubes",
      "kabuki_appart1",
      "appart3",
      "entrepot1",
      "ncpd_watson",
      "cardealer",
      "ncwe_local",
      "polyzone",
      "open77_contextmenu",
      "open77_admin",
      "open77_shell",
      "open77_pause",
      "open77_chat",
      "open77_voice",
      "open-voice",
      "open77_weather",
      "open77_blips",
      "open77_notifications",
      "open77_death",
      "open77_appearance",
      "open77_cyberware",
      "open77_effects",
      "open77_equipment",
      "open77_wardrobe",
      "open77_wardrobe_ui",
      "open77_perspective",
      "open77_animations",
      "open77_prevention",
      "open77_player_interactions",
      "open77_vehicles",
      "open77_elevators",
      "open77_doors",
      "open77_weapons",
      "open77_props",
      "open77_media",
      "open77_remote_camera",
      "open77_interactions",
      "open77_worldui",
      "open77_zones",
      "open77_icons",
      "open77_gizmos_demo",
      "open77_gizmos_editor",
        "open77_chimera",
        "op77_map3d",
        "op77_loadscreen",
        "op77_actionbubble",
        "op77_speedometer",
        "op77_weaponhud",
        "op77_lightrp",
        "op77_scenes",
        "op77_ripperdoc",
        "op77_neuralink"
    ],
    "autoStart": true,
    "watchIntervalMilliseconds": 0,
    "download": {
      "enabled": true,
      "listenUrl": "http://0.0.0.0:11829",
      "publicBaseUrl": "http://127.0.0.1:11829/",
      "allowInsecureHttp": true,
      "cacheDirectory": ".open77/resource-cache",
      "signingKeyFile": ".open77/resource-signing-key.json",
      "chunkSizeBytes": 1048576
    }
  },
  "requiredMods": {
    "enabled": true,
    "unsecured": true,
    "packages": []
  },
  "accessControl": {
    "file": "acl.jsonc"
  },
  "database": {
    "enabled": true,
    "connectionString": "",
    "connectionStringEnvironmentVariable": "OP77_DATABASE_CONNECTION",
    "maxRows": 10000
  },
  "http": {
    "enabled": false,
    "allowedHosts": [],
    "timeoutSeconds": 10,
    "maxResponseBytes": 1048576
  },
  "httpHandlers": {
    "enabled": false,
    "listenUrl": "http://127.0.0.1:11781",
    "timeoutSeconds": 5
  },
  "warden": {
    "enabled": true,
    "listenUrl": "http://127.0.0.1:11830",
    "hubFileGatewayOrigin": "https://files.open2077.net"
  },
  "startup": {
    "commands": []
  }
}
