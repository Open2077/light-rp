!README.md
!server.jsonc
!server.local.jsonc
!server.env.example
!acl.jsonc
!Start-LightRP.cmd
!Start-LightRP-Local.cmd
!templates/
!templates/op77_lightrp/
!templates/op77_lightrp/**
!resources/
!resources/gamemodes/
!resources/gamemodes/op77_lightrp/
!resources/gamemodes/op77_lightrp/**
# ArchiveXL runtime dependency (official 1.28.0 release zip, MIT) and the lobby map
# the first day takes place in: without them the server cannot run the tutorial.
!resources/assets/
!resources/assets/loaders/
!resources/assets/loaders/archivexl/
!resources/assets/loaders/archivexl/**
!resources/assets/maps/
!resources/assets/maps/lobby/
!resources/assets/maps/lobby/**
!resources/assets/maps/open77_lobby_cubes/
!resources/assets/maps/open77_lobby_cubes/**
# NCWE interiors (re-exported for Cyberpunk 2.5 / ArchiveXL 1.28): kabuki_appart1 is the
# starter studio the first day ends in; the others are LightRP's buildings.
!resources/assets/maps/kabuki_appart1/
!resources/assets/maps/kabuki_appart1/**
!resources/assets/maps/appart3/
!resources/assets/maps/appart3/**
!resources/assets/maps/entrepot1/
!resources/assets/maps/entrepot1/**
