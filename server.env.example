# OPEN//77 Official Roleplay — environment loaded by Start-LightRP.cmd.
# Copy to server.env (which is git-ignored) and fill the values in.

# Platform license, created at https://open2077.net/account/keys (op77_live_…, 53 characters).
# Required by server.jsonc (masterServer.enabled = true). Not needed by server.local.jsonc.
OP77_LICENSE_KEY=op77_live_REPLACE_ME

# Owner MySQL/MariaDB for characters, saved positions and reports.
# Create the database and a dedicated user first, for example:
#   CREATE DATABASE open77_lightrp CHARACTER SET utf8mb4;
#   CREATE USER 'lightrp'@'%' IDENTIFIED BY 'change-me';
#   GRANT ALL ON open77_lightrp.* TO 'lightrp'@'%';
OP77_DATABASE_CONNECTION=Server=127.0.0.1;Port=3306;Database=open77_lightrp;User ID=lightrp;Password=change-me;SslMode=None;Allow User Variables=true
