/* Activity HUD (ui/src/features/activityhud/activity-hud.css) on NativeUI. Values are the
   page's at 1920 x 1080: 31vh = 335dp, 22vh = 238dp, 34% = 367dp, 44% = 475dp, the panel
   340dp wide and 410dp high at most. steps() timings are drawn as plain tweens. */

#ah { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 1; font-size: 15dp; line-height: 22dp; color: #C3C7D1; transition: opacity 0.18s cubic-out; }
/* An absolutely positioned element that toggles `display` comes back 0 x 0 (seen in game):
   the root and the positioned wrappers stay laid out and toggle `visibility`. */
#ah.is-quiet { opacity: 0; }
#ah .is-off { display: none; }

/* ---- shared plate: near-black sheet, scanlines, hairline, the accent on the left ---- */
.plate-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; transform: scaleX(-1); decorator: fx(chamfer 10 1 0.84 0 #FFCC0024); box-shadow: #000000A6 0 2dp 14dp 0; }
.plate-bg.plate-lg, .plate-bg.plate-xl { decorator: fx(chamfer 18 1 0.84 0 #FFCC0024); }
.plate-scan { position: absolute; left: 2dp; top: 0; right: 0; bottom: 0; decorator: repeating-linear-gradient(180deg, #FFFFFF09 0dp, #FFFFFF09 1dp, #FFFFFF00 1dp, #FFFFFF00 3dp); }
.plate-rail { position: absolute; left: 0; top: 10dp; bottom: 0; width: 2dp; background-color: #FFCC00; }
.plate-rail.plate-lg, .plate-rail.plate-xl { top: 18dp; }
/* a small chamfered HUD chip (surface-hud, --clip-chamfer-sm) */
.cut-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; transform: scaleX(-1); decorator: fx(chamfer 6 0 0.72 0 #00000000); }
.cut-bg.cut-md { decorator: fx(chamfer 10 0 0.72 0 #00000000); }
/* Keycap size="sm" (design/components) */
.kc { display: block; flex: 0 0 auto; min-width: 16dp; padding: 1dp 5dp; font-family: "Share Tech Mono"; font-weight: normal; font-size: 10dp; line-height: 11dp; letter-spacing: 0.06em; text-align: center; color: #C3C7D1; decorator: fx(chamfer 4 1 1 0 #FFCC0047); }

/* ---- header strip, top centre ---- */
.ah-head-pos { position: absolute; left: 0; right: 0; top: 26dp; display: flex; visibility: hidden; flex-direction: row; justify-content: center; }
#ah.is-on .ah-head-pos.is-in { visibility: visible; }
#ah.is-lowered .ah-head-pos { top: 78dp; }
#ah.is-lowered-2 .ah-head-pos { top: 118dp; }
.ah-head { display: flex; flex-direction: column; align-items: center; gap: 6dp; max-width: 760dp; }
#ah.is-on .ah-head-pos.is-in .ah-head { animation: 0.32s cubic-out ah-drop; }
.ah-plate { position: relative; }
.ah-head-in { position: relative; display: flex; flex-direction: row; align-items: center; gap: 16dp; min-height: 32dp; padding: 6dp 16dp 6dp 16dp; }
.ah-head-id { display: flex; flex-direction: row; align-items: center; gap: 8dp; flex-shrink: 0; }
.ah-title { color: #F2F3F5; font-size: 15dp; line-height: 15dp; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; }
.ah-sub { display: block; color: #8A8F9C; font-size: 13dp; line-height: 14dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240dp; }
.ah-head-mid { display: flex; flex-direction: row; align-items: center; gap: 12dp; padding-left: 16dp; border-left-width: 1dp; border-left-color: #FFCC0024; flex-shrink: 0; }

.ah-phase { display: flex; flex-direction: row; flex: 0 0 auto; height: 18dp; }
.ah-phase-text { display: block; height: 18dp; padding: 4dp 4dp 3dp 7dp; box-sizing: border-box; font-family: "Share Tech Mono"; font-weight: normal; font-size: 11dp; line-height: 11dp; letter-spacing: 0.14em; white-space: nowrap; color: #8A8F9C; background-color: #202127; }
.ah-phase-tail { display: block; flex: 0 0 auto; width: 8dp; height: 18dp; fill: #202127; }
.ah-phase.is-countdown .ah-phase-text { color: #FFCC00; background-color: #FFCC0038; }
.ah-phase.is-countdown .ah-phase-tail { fill: #FFCC0038; }
.ah-phase.is-running .ah-phase-text { color: #050506; background-color: #FFCC00; }
.ah-phase.is-running .ah-phase-tail { fill: #FFCC00; }
.ah-phase.is-ended .ah-phase-text { color: #F2F3F5; background-color: #2B2D34; }
.ah-phase.is-ended .ah-phase-tail { fill: #2B2D34; }

.ah-clock { display: flex; flex-direction: column; align-items: center; gap: 3dp; min-width: 76dp; }
.ah-clock-label { color: #565A66; font-family: "Share Tech Mono"; font-weight: normal; font-size: 10dp; line-height: 10dp; letter-spacing: 0.14em; white-space: nowrap; }
.ah-clock-digits { color: #F2F3F5; font-family: "Share Tech Mono"; font-weight: normal; font-size: 22dp; line-height: 22dp; letter-spacing: 0.02em; white-space: nowrap; }
.ah-clock.is-up .ah-clock-digits { color: #FFCC00; font-effect: glow(1dp 5dp 0dp 0dp #FFCC0060); }
.ah-clock.is-low .ah-clock-digits { color: #FF2E3C; animation: 1s linear-in-out infinite ah-blink; }
.ah-versus { color: #565A66; font-family: "Share Tech Mono"; font-weight: normal; font-size: 13dp; line-height: 13dp; letter-spacing: 0.14em; }

/* two teams flank the clock */
.ah-side { display: flex; flex-direction: row; align-items: center; gap: 8dp; padding-bottom: 3dp; border-bottom-width: 2dp; border-bottom-color: #565A66; }
.ah-side.is-right { flex-direction: row-reverse; }
.ah-side-name { display: block; color: #8A8F9C; font-family: "Share Tech Mono"; font-weight: normal; font-size: 11dp; line-height: 11dp; letter-spacing: 0.14em; text-transform: uppercase; max-width: 110dp; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ah-side-score { color: #F2F3F5; font-family: "Share Tech Mono"; font-weight: normal; font-size: 24dp; line-height: 24dp; white-space: nowrap; }
.ah-side.is-self .ah-side-name { color: #FFCC00; }

/* three or four teams: chips under the strip */
.ah-teams { display: flex; flex-direction: row; gap: 6dp; }
.ah-team { position: relative; display: flex; flex-direction: row; align-items: center; gap: 8dp; padding: 4dp 10dp 4dp 0; }
.ah-team-bar { position: relative; align-self: stretch; width: 3dp; min-height: 15dp; background-color: #565A66; }
.ah-team-name { position: relative; color: #8A8F9C; font-family: "Share Tech Mono"; font-weight: normal; font-size: 11dp; line-height: 11dp; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; }
.ah-team-score { position: relative; color: #F2F3F5; font-family: "Share Tech Mono"; font-weight: normal; font-size: 15dp; line-height: 15dp; white-space: nowrap; }
.ah-team.is-self .cut-bg { decorator: fx(chamfer 6 1 0.72 0 #FFCC0047); }
.ah-team.is-self .ah-team-name { color: #FFCC00; }

.ah-objective { position: relative; display: flex; flex-direction: row; align-items: center; gap: 6dp; padding: 4dp 12dp; }
.ah-objective path.ic { position: relative; width: 12dp; height: 12dp; stroke: #FFCC00; }
.ah-objective-text { position: relative; color: #F2F3F5; font-size: 13dp; line-height: 16dp; letter-spacing: 0.02em; }
.ah-head-hints { position: relative; display: flex; flex-direction: row; flex-wrap: wrap; gap: 6dp 16dp; padding: 5dp 10dp; }

/* ---- countdown, centre ---- */
.ah-count-pos { position: absolute; left: 0; right: 0; top: 367dp; display: flex; visibility: hidden; flex-direction: row; justify-content: center; }
#ah.is-on .ah-count-pos.is-in { visibility: visible; }
.ah-count-y { transform: translateY(-50%); }
.ah-count { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6dp; }
.ah-count.is-far, .ah-count.is-wait { padding: 8dp 24dp; }
.ah-count-digit { display: block; color: #FFCC00; font-family: "Zen Dots"; font-weight: normal; font-size: 112dp; line-height: 112dp; white-space: nowrap; opacity: 0.2; transform: scale(0.9); font-effect: glow(1dp 6dp 0dp 0dp #FFCC0073), shadow(0dp 4dp #000000B3); }
.ah-count-digit.is-a { animation: 0.9s linear-in-out ah-count-a; }
.ah-count-digit.is-b { animation: 0.9s linear-in-out ah-count-b; }
.ah-count-digit.is-go { letter-spacing: 0.06em; }
.ah-count-digit.is-go.is-a { animation: 0.6s linear-in-out ah-count-a; }
.ah-count-digit.is-go.is-b { animation: 0.6s linear-in-out ah-count-b; }
.ah-count-small { position: relative; color: #8A8F9C; font-family: "Share Tech Mono"; font-weight: normal; font-size: 11dp; line-height: 11dp; letter-spacing: 0.22em; white-space: nowrap; }
.ah-count-far { position: relative; color: #F2F3F5; font-family: "Share Tech Mono"; font-weight: normal; font-size: 30dp; line-height: 30dp; white-space: nowrap; }
.ah-count-wait { position: relative; color: #FFCC00; font-family: "Share Tech Mono"; font-weight: normal; font-size: 13dp; line-height: 13dp; letter-spacing: 0.22em; white-space: nowrap; animation: 1.4s linear-in-out infinite ah-blink; }

/* ---- match panel, the work order's slot ---- */
.ah-panel { position: absolute; top: 335dp; right: 32dp; width: 340dp; max-height: 410dp; overflow: hidden; visibility: hidden; }
#ah.is-on .ah-panel.is-in { visibility: visible; animation: 0.42s cubic-out ah-slide; }
.ah-panel-in { position: relative; display: flex; flex-direction: column; }
.ah-panel-in > div { flex: 0 0 auto; }
.ah-panel-in > div.sep { border-top-width: 1dp; border-top-color: #FFCC0024; }

.ah-stats { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12dp 16dp; padding: 16dp 16dp 12dp 24dp; }
.ah-stat { display: flex; flex-direction: column; gap: 4dp; width: 142dp; overflow: hidden; }
.ah-stats.n1 .ah-stat { width: 300dp; }
.ah-stats.n3 .ah-stat { width: 89dp; }
.ah-stat-label { display: block; color: #565A66; font-family: "Share Tech Mono"; font-weight: normal; font-size: 10dp; line-height: 10dp; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ah-stat-value { display: block; color: #F2F3F5; font-family: "Share Tech Mono"; font-weight: normal; font-size: 20dp; line-height: 20dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ah-stat:first-child .ah-stat-value { color: #FFCC00; font-effect: glow(1dp 5dp 0dp 0dp #FFCC0060); }

.ah-bars { display: flex; flex-direction: column; gap: 8dp; padding: 12dp 16dp 12dp 24dp; }
.ah-bar-head { display: flex; flex-direction: row; justify-content: space-between; margin-bottom: 4dp; font-family: "Share Tech Mono"; font-weight: normal; font-size: 10dp; line-height: 10dp; letter-spacing: 0.14em; color: #8A8F9C; text-transform: uppercase; }
.ah-bar-pct { color: #F2F3F5; }
.ah-bar-track { height: 4dp; background-color: #2B2D34; }
.ah-bar-fill { height: 4dp; background-color: #FFCC00; transition: width 0.32s cubic-out; }

.ah-board { display: flex; flex-direction: column; gap: 1dp; padding: 8dp 12dp 8dp 20dp; overflow: hidden; }
.ah-row { position: relative; display: flex; flex-direction: row; align-items: center; gap: 8dp; padding: 4dp 6dp; font-size: 13dp; line-height: 16dp; color: #8A8F9C; }
.ah-rank { display: block; flex: 0 0 auto; width: 20dp; font-family: "Share Tech Mono"; font-weight: normal; font-size: 11dp; line-height: 11dp; color: #565A66; }
.ah-name { display: flex; flex-direction: row; align-items: center; gap: 6dp; flex: 1 1 0; min-width: 0; overflow: hidden; }
.ah-dot { flex: 0 0 auto; width: 6dp; height: 6dp; background-color: #565A66; }
.ah-name-text { display: block; flex: 1 1 0; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ah-cell { display: block; flex: 0 0 auto; min-width: 36dp; text-align: right; font-family: "Share Tech Mono"; font-weight: normal; font-size: 12dp; line-height: 12dp; white-space: nowrap; }
.ah-row.is-head { padding-top: 0; padding-bottom: 2dp; font-family: "Share Tech Mono"; font-weight: normal; font-size: 10dp; line-height: 10dp; letter-spacing: 0.14em; color: #565A66; }
.ah-row.is-head .ah-rank, .ah-row.is-head .ah-cell { font-size: 10dp; line-height: 10dp; }
.ah-row.is-self { background-color: #FFCC001F; border-left-width: 2dp; border-left-color: #FFCC00; padding-left: 4dp; color: #F2F3F5; }
.ah-row.is-self .ah-rank { color: #FFCC00; }
.ah-gap { position: absolute; left: 0; right: 0; top: 2dp; height: 2dp; visibility: hidden; }
.ah-row.is-gap { height: 6dp; margin: 1dp 6dp; padding: 0; }
.ah-row.is-gap .ah-rank, .ah-row.is-gap .ah-name, .ah-row.is-gap .ah-cell { display: none; }
.ah-row.is-gap .ah-gap { visibility: visible; decorator: repeating-linear-gradient(90deg, #3A3D4600 0dp, #3A3D4600 3dp, #3A3D46 3dp, #3A3D46 5dp, #3A3D4600 5dp, #3A3D4600 8dp); }

.ah-hints { display: flex; flex-direction: row; flex-wrap: wrap; gap: 6dp 16dp; padding: 8dp 16dp 8dp 24dp; background-color: #00000040; }
.ah-hint { position: relative; display: flex; flex-direction: row; align-items: center; gap: 6dp; }
.ah-hint-text { color: #C3C7D1; font-family: "Share Tech Mono"; font-weight: normal; font-size: 11dp; line-height: 11dp; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }

/* ---- feed, left of the minimap ---- */
.ah-feed { position: absolute; top: 26dp; right: 336dp; width: 300dp; visibility: hidden; display: flex; flex-direction: column; align-items: flex-end; gap: 3dp; }
#ah.is-on .ah-feed { visibility: visible; }
.ah-feed-item { position: relative; max-width: 300dp; padding: 5dp 10dp 5dp 12dp; box-sizing: border-box; opacity: 1; transition: opacity 0.62s linear-in-out; animation: 0.24s cubic-out ah-feed-in; }
.ah-feed-item.is-out { opacity: 0; }
.ah-feed-rail { position: absolute; right: 0; top: 0; bottom: 6dp; width: 2dp; background-color: #3A3D46; }
.ah-feed-text { display: block; position: relative; color: #C3C7D1; font-size: 13dp; line-height: 16dp; }
.ah-feed-item.is-hi .ah-feed-text { color: #F2F3F5; }

/* ---- banner ---- */
.ah-banner-pos { position: absolute; left: 0; right: 0; top: 238dp; display: flex; visibility: hidden; flex-direction: row; justify-content: center; }
#ah.is-on .ah-banner-pos.is-in { visibility: visible; }
/* the life fade on a wrapper, the entry animation on the banner: one opacity animation per element */
.ah-banner-fade { opacity: 1; transition: opacity 0.36s linear-in-out; }
.ah-banner-fade.is-out { opacity: 0; }
.ah-banner { position: relative; display: flex; flex-direction: column; align-items: center; gap: 6dp; min-width: 276dp; padding: 12dp 72dp; }
.ah-banner.is-a { animation: 0.28s cubic-out ah-banner-a; }
.ah-banner.is-b { animation: 0.28s cubic-out ah-banner-b; }
.ah-banner-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; decorator: linear-gradient(90deg, #06060800 0%, #060608D6 22%, #060608D6 78%, #06060800 100%); }
.ah-banner-line { position: absolute; left: 22%; right: 22%; height: 1dp; background-color: #FFCC00; opacity: 0.6; }
.ah-banner-line.is-top { top: 0; }
.ah-banner-line.is-bottom { bottom: 0; }
.ah-banner-title { display: block; position: relative; color: #FFCC00; font-family: "Zen Dots"; font-weight: normal; font-size: 34dp; line-height: 36dp; letter-spacing: 0.04em; text-transform: uppercase; text-align: center; font-effect: shadow(0dp 2dp #000000CC); }
.ah-banner-title.is-accent { font-effect: glow(1dp 6dp 0dp 0dp #FFCC0073); }
.ah-banner-text { display: block; position: relative; color: #C3C7D1; font-size: 13dp; line-height: 16dp; letter-spacing: 0.02em; text-align: center; }

/* ---- result card ---- */
.ah-result-pos { position: absolute; left: 0; right: 0; top: 475dp; display: flex; visibility: hidden; flex-direction: row; justify-content: center; }
#ah.is-on .ah-result-pos.is-in { visibility: visible; }
.ah-result-y { transform: translateY(-50%); }
.ah-result { position: relative; width: 460dp; }
.ah-result.is-a { animation: 0.36s cubic-out ah-pop-a; }
.ah-result.is-b { animation: 0.36s cubic-out ah-pop-b; }
.ah-result-in { position: relative; }
.ah-result-top { display: flex; flex-direction: row; align-items: center; gap: 20dp; padding: 20dp 24dp 16dp 28dp; }
.ah-place { display: flex; flex-direction: row; align-items: flex-start; flex: 0 0 auto; }
.ah-place-n { display: block; color: #F2F3F5; font-family: "Zen Dots"; font-weight: normal; font-size: 64dp; line-height: 64dp; white-space: nowrap; }
.ah-place-n.is-word { font-size: 40dp; line-height: 40dp; letter-spacing: 0.04em; }
.ah-place-sup { display: block; margin: 6dp 0 0 4dp; color: #8A8F9C; font-family: "Share Tech Mono"; font-weight: normal; font-size: 15dp; line-height: 15dp; letter-spacing: 0.06em; }
.ah-result.is-first .ah-place-n, .ah-result.is-first .ah-place-sup { color: #FFCC00; font-effect: glow(1dp 6dp 0dp 0dp #FFCC0073); }
.ah-result-id { display: flex; flex-direction: column; gap: 5dp; flex: 1 1 0; min-width: 0; }
.ah-result-tag { display: block; color: #FFCC00; font-family: "Share Tech Mono"; font-weight: normal; font-size: 11dp; line-height: 11dp; letter-spacing: 0.22em; }
.ah-result-title { display: block; color: #F2F3F5; font-size: 22dp; line-height: 26dp; text-transform: uppercase; letter-spacing: 0.02em; }
.ah-result-sub { display: block; color: #8A8F9C; font-size: 13dp; line-height: 16dp; }
.ah-lines { display: flex; flex-direction: row; flex-wrap: wrap; gap: 1dp; padding: 0 16dp 16dp 28dp; }
.ah-line { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; gap: 8dp; width: 207dp; box-sizing: border-box; padding: 7dp 10dp; background-color: #FFFFFF06; border-bottom-width: 1dp; border-bottom-color: #FFCC0024; overflow: hidden; }
.ah-line-label { display: block; flex: 0 0 auto; color: #565A66; font-family: "Share Tech Mono"; font-weight: normal; font-size: 10dp; line-height: 10dp; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; }
.ah-line-value { display: block; flex: 0 1 auto; min-width: 0; color: #F2F3F5; font-family: "Share Tech Mono"; font-weight: normal; font-size: 13dp; line-height: 13dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ah-life { position: absolute; left: 0; bottom: 0; height: 2dp; background-color: #FFCC00; transition: width 0.12s linear-in-out; }

@keyframes ah-drop { from { opacity: 0; transform: translateY(-10dp); } to { opacity: 1; transform: translateY(0dp); } }
@keyframes ah-slide { 0% { opacity: 0; transform: translateX(24dp); } 40% { opacity: 0.5; } 100% { opacity: 1; transform: translateX(0dp); } }
@keyframes ah-pop-a { from { opacity: 0; transform: translateY(18dp); } to { opacity: 1; transform: translateY(0dp); } }
@keyframes ah-pop-b { from { opacity: 0; transform: translateY(18dp); } to { opacity: 1; transform: translateY(0dp); } }
@keyframes ah-count-a { 0% { opacity: 0; transform: scale(1.5); } 30% { opacity: 1; transform: scale(1); } 80% { opacity: 1; } 100% { opacity: 0.2; transform: scale(0.9); } }
@keyframes ah-count-b { 0% { opacity: 0; transform: scale(1.5); } 30% { opacity: 1; transform: scale(1); } 80% { opacity: 1; } 100% { opacity: 0.2; transform: scale(0.9); } }
@keyframes ah-feed-in { from { transform: translateX(12dp); } to { transform: translateX(0dp); } }
@keyframes ah-banner-a { from { opacity: 0; transform: scaleX(0.6); } to { opacity: 1; transform: scaleX(1); } }
@keyframes ah-banner-b { from { opacity: 0; transform: scaleX(0.6); } to { opacity: 1; transform: scaleX(1); } }
@keyframes ah-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0.35; } }
