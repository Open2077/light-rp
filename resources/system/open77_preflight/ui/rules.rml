<rml>
  <head>
    <title>Server rules</title>
    <style>
      body { display: flex; flex-direction: column; gap: 14px; padding: 22px; color: var(--text); font-size: 14px; line-height: 1.45em; }
      h1 { font-size: 22px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }
      .server { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted); }
      .muted { color: var(--muted); font-size: 12px; }
      .panel { display: flex; flex-direction: column; gap: 8px; background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 6px; padding: 14px; }
      .notice { color: var(--accent); font-weight: bold; }
      .error { color: #ff5a5a; font-weight: bold; }
      ul { display: flex; flex-direction: column; gap: 6px; padding-left: 16px; }
      .check { display: flex; flex-direction: row; align-items: center; gap: 8px; }
      .actions { display: flex; flex-direction: row; justify-content: flex-end; gap: 10px; }
      button { padding: 10px 18px; border-radius: 4px; border-width: 1px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }
      .primary { background-color: var(--accent); border-color: var(--accent); color: #0b0d10; }
      .primary:hover { opacity: 0.85; }
      .secondary { background-color: var(--panel); border-color: var(--line); color: var(--muted); }
      .secondary:hover { color: var(--text); }
    </style>
  </head>
  <body>
    <span class="server">{{ server }}</span>
    <h1>{{ title }}</h1>
    <p>Hello {{ name }}. Read and accept the rules to join.</p>
    <p class="notice" data-if="notice">{{ notice }}</p>
    <div class="panel" data-if="hasAnnouncements">
      <ul>
        <li data-for="line : announcements">{{ line }}</li>
      </ul>
    </div>
    <div class="panel">
      <ul>
        <li data-for="rule : rules">{{ rule }}</li>
      </ul>
    </div>
    <div class="check" data-if="checkbox">
      <input id="agree" type="checkbox"/>
      <span>I have read the rules and I accept them.</span>
    </div>
    <p class="error" data-if="error">{{ error }}</p>
    <div class="actions">
      <button class="secondary" data-event-click="decline_rules">Decline</button>
      <button class="primary" data-event-click="accept_rules">I accept</button>
    </div>
    <span class="muted">Rules version {{ version }}. You are asked once, and again when the rules change.</span>
  </body>
</rml>
